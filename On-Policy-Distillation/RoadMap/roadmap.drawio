<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="30.3.14">
  <diagram name="01｜五种基线" id="page0">
    <mxGraphModel dx="1720" dy="1180" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="1" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page0-2" value="&lt;b&gt;SFT · PPO · GRPO · OPD · OPSD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;先区分轨迹来自谁、监督来自谁，再比较 loss；箭头表示组件变换，不表示唯一训练顺序。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=28;spacing=14;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1640" height="100" />
        </mxCell>
        <mxCell id="page0-3" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;SFT&lt;/b&gt;&lt;br&gt;参考文本 → 明确目标&lt;br&gt;&lt;br&gt;$$\mathcal L_{\mathrm{SFT}}=-\sum_t\log\pi_\theta(y_t^*\mid x,y_{&amp;lt;t}^*)$$&lt;br&gt;&lt;br&gt;强项：稳定、适合冷启动&lt;br&gt;问题：参考前缀与推理前缀不同&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=21;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="190" width="510" height="290" />
        </mxCell>
        <mxCell id="page0-4" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;PPO&lt;/b&gt;&lt;br&gt;学生尝试 → reward + critic&lt;br&gt;&lt;br&gt;$$\widehat A_t=\sum_{l\ge0}(\gamma\lambda)^l\delta_{t+l}$$&lt;br&gt;&lt;br&gt;强项：任务收益、可 bootstrap&lt;br&gt;问题：critic 偏差与探索成本&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=21;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="190" width="510" height="290" />
        </mxCell>
        <mxCell id="page0-5" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;GRPO&lt;/b&gt;&lt;br&gt;同题多条回答互相比较&lt;br&gt;&lt;br&gt;$$\widehat A_i=\frac{R_i-\bar R}{\sigma_R+\epsilon}$$&lt;br&gt;&lt;br&gt;强项：省 learned critic&lt;br&gt;问题：全同奖励为零、信用粗&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=21;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="190" width="510" height="290" />
        </mxCell>
        <mxCell id="page0-6" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;OPD&lt;/b&gt;&lt;br&gt;学生前缀 → teacher 分布&lt;br&gt;&lt;br&gt;$$\mathcal L_{\mathrm{OPD}}=\mathbb E_{y\sim\pi_\theta}\sum_t D(p_t,q_t)$$&lt;br&gt;&lt;br&gt;强项：局部反馈密集&lt;br&gt;问题：teacher 偏好未必有益&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=21;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="550" width="510" height="290" />
        </mxCell>
        <mxCell id="page0-7" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;OPSD&lt;/b&gt;&lt;br&gt;同模型 + 额外信息作 teacher&lt;br&gt;&lt;br&gt;$$q_t=\pi_{\bar\theta}(\cdot\mid x,z,y_{&amp;lt;t})$$&lt;br&gt;&lt;br&gt;强项：利用自身信息优势&lt;br&gt;问题：z 缺失、风格和探索错配&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=21;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="550" width="510" height="290" />
        </mxCell>
        <mxCell id="page0-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#536a72;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;entryX=0;entryY=0.1;" edge="1" parent="1" source="page0-4" target="page0-5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="page0-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#536a72;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;entryX=0;entryY=0.1;" edge="1" parent="1" source="page0-6" target="page0-7">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="page0-10" value="PPO → GRPO：将 value baseline 换成同题组统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=14;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="495" width="1070" height="40" />
        </mxCell>
        <mxCell id="page0-11" value="OPD → OPSD：让同模型 teacher 获得额外参考信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=14;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="880" width="1070" height="55" />
        </mxCell>
        <mxCell id="page0-12" value="&lt;b&gt;一个共同框架&lt;/b&gt;&lt;br&gt;题目 → 采样状态 → 构造信号 → 权重 / 归一化 → 更新&lt;br&gt;&lt;br&gt;改动可以很小，但“目标变了”与“只换估计器”必须区分。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=22;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="550" width="510" height="290" />
        </mxCell>
        <mxCell id="page0-13" value="数据 / 轨迹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1000" width="310" height="50" />
        </mxCell>
        <mxCell id="page0-14" value="teacher / 接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1000" width="310" height="50" />
        </mxCell>
        <mxCell id="page0-15" value="监督信号 / 估计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="1000" width="310" height="50" />
        </mxCell>
        <mxCell id="page0-16" value="权重 / 归一化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="1000" width="310" height="50" />
        </mxCell>
        <mxCell id="page0-17" value="更新 / 长度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=16;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1360" y="1000" width="310" height="50" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="02｜十个组件" id="page1">
    <mxGraphModel dx="1720" dy="1180" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="1" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page1-2" value="&lt;b&gt;训练循环的十个可修改位置&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;每篇论文可以同时修改多个位置；长度 L 横跨采样 H、信号 A、权重 W 和归一化 N。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=28;spacing=14;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1640" height="100" />
        </mxCell>
        <mxCell id="page1-3" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;D｜题目与训练数据&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(x\sim\mathcal D\)&lt;br&gt;题目 / 参考数据&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="410" width="210" height="190" />
        </mxCell>
        <mxCell id="page1-4" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;H｜rollout 与前缀分布&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(y\sim\mu\)&lt;br&gt;rollout / prefix&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="410" width="210" height="190" />
        </mxCell>
        <mxCell id="page1-5" value="&lt;b&gt;I｜监督接口与动作单位&lt;/b&gt;&lt;br&gt;&lt;br&gt;token / 文本单位&lt;br&gt;监督对齐接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="410" width="210" height="190" />
        </mxCell>
        <mxCell id="page1-6" value="&lt;b&gt;F｜散度、估计器与梯度路径&lt;/b&gt;&lt;br&gt;&lt;br&gt;KL / MC / sg&lt;br&gt;loss 与梯度路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="410" width="210" height="190" />
        </mxCell>
        <mxCell id="page1-7" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;W｜token / trajectory 权重与门控&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(m_t w_t\)&lt;br&gt;筛选 / 加权&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
