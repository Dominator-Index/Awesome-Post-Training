  <diagram name="03｜论文组件地图" id="page2">
    <mxGraphModel dx="1720" dy="2220" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1720" pageHeight="2220" math="1" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page2-2" value="&lt;b&gt;论文在哪里动手：按组件查，而非按新名字记&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;每张卡是一个可继续展开的组件分支；一篇论文可出现多次。细节与关键公式见认知卡片 / 离线浏览器。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=28;spacing=14;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
