        <mxCell id="page1-16" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;T｜teacher 与信息&lt;/b&gt;&lt;br&gt;外部模型 / 自教师 / reference&lt;br&gt;crop / feedback / harness&lt;br&gt;&lt;b&gt;\(q(\cdot\mid h,z)\)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=21;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
