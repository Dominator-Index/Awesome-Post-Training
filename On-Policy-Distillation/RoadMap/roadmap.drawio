        </mxCell>
        <mxCell id="page1-8" value="&lt;div style=&quot;padding:12px;box-sizing:border-box;&quot;&gt;&lt;b&gt;N｜advantage / loss 归一化&lt;/b&gt;&lt;br&gt;&lt;br&gt;\(\sigma, Z\)&lt;br&gt;尺度 / 聚合&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=block;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#172f36;fontFamily=Noto Sans CJK SC;fontSize=18;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
